{
  "name": "jobapplicationtracker",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "server": "cd Backend && npm run dev",
    "client": "cd Frontend && npm run dev",
    "dev": "concurrently \"npm:server\" \"npm:client\"",
    "installDeps": "npm install && cd Backend && npm install && cd ../Frontend && npm install",
    "lint": "npm --prefix Frontend run lint && npm --prefix Backend run lint",
    "seedDatabase": "cd Backend && npm run seed",
    "prisma:generate": "cd Backend && npx prisma generate",
    "prisma:migrate": "cd Backend && npx prisma migrate dev",
    "prisma:studio": "cd Backend && npx prisma studio",
    "check": "npm run lint && npm --prefix Frontend run build && npm --prefix Frontend run test:run && npm --prefix Backend run test:run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zacharycampanelli/JobApplicationTracker.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Zacharycampanelli/JobApplicationTracker/issues"
  },
  "homepage": "https://github.com/Zacharycampanelli/JobApplicationTracker#readme",
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
