generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int              @id @default(autoincrement())
  email        String           @unique
  password     String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  name         String           @default("User")
  applications JobApplication[]
  resumes      Resume[]
  preferences  UserPreferences?
  profile      UserProfile?

  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model JobApplication {
  id              Int                @id @default(autoincrement())
  publicId        String             @unique @default(cuid())
  title           String
  company         String
  appliedAt       DateTime           @default(now())
  notes           String?
  link            String?
  userId          Int
  status          JobStatus
  resumeId        Int?
  location        String?
  createdAt       DateTime           @default(now())
  firstResponseAt DateTime?
  interviewAt     DateTime?
  offerAt         DateTime?
  rejectedAt      DateTime?
  salaryMax       Int?
  salaryMin       Int?
  source          ApplicationSource?
  updatedAt       DateTime           @updatedAt
  workMode        WorkMode?
  resume          Resume?            @relation(fields: [resumeId], references: [id])
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Resume {
  id           Int              @id @default(autoincrement())
  name         String
  fileUrl      String
  userId       Int
  createdAt    DateTime         @default(now())
  mimeType     String
  applications JobApplication[]
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserProfile {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  summary   String?
  title     String?
  location  String?
  website   String?
  linkedin  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  avatarUrl String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserPreferences {
  id                       Int      @id @default(autoincrement())
  userId                   Int      @unique
  publicProfileEnabled     Boolean  @default(false)
  autoStatusUpdatesEnabled Boolean  @default(false)
  themePreference          String   @default("system")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum JobStatus {
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
}

enum ApplicationSource {
  LINKEDIN
  INDEED
  COMPANY_SITE
  REFERRAL
  RECRUITER
  NETWORKING
  OTHER
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}
