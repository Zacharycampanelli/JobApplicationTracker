# Local server settings
NODE_ENV=development
PORT=5001
FRONTEND_URL=http://localhost:5173

# Replace with your local PostgreSQL credentials and database name.
# Both URLs can match when using a local PostgreSQL database.
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/job_tracker
DIRECT_URL=postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/job_tracker

# Replace with a long, randomly generated secret.
JWT_SECRET=replace-with-a-random-secret

# Required at startup; real values are needed to send password-reset emails.
BREVO_API_KEY=replace-with-your-brevo-api-key
EMAIL_FROM_ADDRESS=sender@example.com

# Optional settings
EMAIL_FROM_NAME="Job Tracker"
# ADDITIONAL_TRUSTED_ORIGINS=http://localhost:5174
